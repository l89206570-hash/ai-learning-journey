5668\u672c\u8d28\u662f\u95ed\u5305\uff0c\u63a5\u6536\u51fd\u6570\u4f5c\u4e3a\u53c2\u6570\uff0c\u8fd4\u56de\u65b0\u51fd\u6570\u3002@decorator \u8bed\u6cd5\u7b49\u4ef7\u4e8e func = decorator(func)\u3002\u5e38\u89c1\u7528\u9014\uff1a\u65e5\u5fd7\u8bb0\u5f55\u3001\u6743\u9650\u6821\u9a8c\u3001\u7f13\u5b58\u3001\u8ba1\u65f6\u3002\n\n### \u6570\u636e\u5e93\nQ: MySQL \u7d22\u5f15\u539f\u7406\nA: \u9ed8\u8ba4\u4f7f\u7528 B+ \u6811\u7d22\u5f15\u3002B+ \u6811\u6240\u6709\u6570\u636e\u5b58\u5728\u53f6\u5b50\u8282\u70b9\uff0c\u53f6\u5b50\u8282\u70b9\u4e4b\u95f4\u7528\u53cc\u5411\u94fe\u8868\u8fde\u63a5\uff0c\u652f\u6301\u8303\u56f4\u67e5\u8be2\u3002\u4e3b\u952e\u7d22\u5f15\uff08\u805a\u7c07\u7d22\u5f15\uff09\u53f6\u5b50\u8282\u70b9\u5b58\u5b8c\u6574\u884c\u6570\u636e\uff1b\u4e8c\u7ea7\u7d22\u5f15\u53f6\u5b50\u8282\u70b9\u5b58\u4e3b\u952e\u503c\uff0c\u9700\u8981\u56de\u8868\u67e5\u8be2\u3002\u8054\u5408\u7d22\u5f15\u9075\u5faa\u6700\u5de6\u524d\u7f00\u539f\u5219\u3002\n\nQ: Redis \u5e38\u89c1\u6570\u636e\u7ed3\u6784\u53ca\u5e94\u7528\u573a\u666f\nA: String\uff08\u7f13\u5b58\u3001\u8ba1\u6570\u5668\uff09\u3001Hash\uff08\u5bf9\u8c61\u5b58\u50a8\uff09\u3001List\uff08\u6d88\u606f\u961f\u5217\u3001\u6700\u65b0\u5217\u8868\uff09\u3001Set\uff08\u53bb\u91cd\u3001\u5171\u540c\u597d\u53cb\uff09\u3001Sorted Set\uff08\u6392\u884c\u699c\u3001\u5ef6\u8fdf\u961f\u5217\uff09\u3001Bitmap\uff08\u7b7e\u5230\u7edf\u8ba1\uff09\u3001HyperLogLog\uff08UV \u7edf\u8ba1\uff09\u3002", "mimetype": "text/plain", "start_char_idx": 0, "end_char_idx": 529, "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}, "e9333c1c-fff0-45d8-9dce-f99c394a442c": {"__data__": {"id_": "e9333c1c-fff0-45d8-9dce-f99c394a442c", "embedding": null, "metadata": {"category": "\u524d\u7aef\u57fa\u7840", "source": "frontend\u57fa\u7840.txt"}, "excluded_embed_metadata_keys": [], "excluded_llm_metadata_keys": [], "relationships": {"1": {"node_id": "3badbb04-07dc-4857-a59e-5918a794cb88", "node_type": "4", "metadata": {"category": "\u524d\u7aef\u57fa\u7840", "source": "frontend\u57fa\u7840.txt"}, "hash": "531900f2ad1512224d4810c23ea7df35892e1014676fbf821c91bf395a8c19f5", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "## \u524d\u7aef\u57fa\u7840\u9762\u8bd5\u9898\n\n### HTML/CSS\nQ: \u8bf4\u4e00\u4e0b\u76d2\u6a21\u578b\nA: CSS \u76d2\u6a21\u578b\u6709\u4e24\u79cd\uff1a\u6807\u51c6\u76d2\u6a21\u578b\uff08content-box\uff09\u548c IE \u76d2\u6a21\u578b\uff08border-box\uff09\u3002\u6807\u51c6\u76d2\u6a21\u578b\u7684 width \u53ea\u5305\u542b content\uff1bIE \u76d2\u6a21\u578b\u7684 width \u5305\u542b content + padding + border\u3002\u53ef\u4ee5\u901a\u8fc7 box-sizing \u5c5e\u6027\u5207\u6362\u3002\n\nQ: flex \u5e03\u5c40\u5e38\u7528\u5c5e\u6027\nA: \u5bb9\u5668\u5c5e\u6027\uff1adisplay:flex, justify-content\uff08\u4e3b\u8f74\u5bf9\u9f50\uff09, align-items\uff08\u4ea4\u53c9\u8f74\u5bf9\u9f50\uff09, flex-direction\uff08\u4e3b\u8f74\u65b9\u5411\uff09, flex-wrap\uff08\u6362\u884c\uff09\u3002\u9879\u76ee\u5c5e\u6027\uff1aflex\uff08\u7b80\u5199 grow/shrink/basis\uff09, align-self\uff08\u5355\u72ec\u5bf9\u9f50\uff09\u3002\n\n### JavaScript\nQ: \u95ed\u5305\u662f\u4ec0\u4e48\nA: \u95ed\u5305\u662f\u51fd\u6570\u80fd\u8bbf\u95ee\u5176\u5916\u90e8\u4f5c\u7528\u57df\u53d8\u91cf\u7684\u80fd\u529b\u3002\u539f\u7406\u662f\u51fd\u6570\u6267\u884c\u65f6\u4f1a\u521b\u5efa\u6267\u884c\u4e0a\u4e0b\u6587\u548c\u8bcd\u6cd5\u73af\u5883\uff0c\u5185\u90e8\u51fd\u6570\u4fdd\u6301\u5bf9\u5916\u90e8\u8bcd\u6cd5\u73af\u5883\u7684\u5f15\u7528\uff0c\u5373\u4f7f\u5916\u90e8\u51fd\u6570\u5df2\u6267\u884c\u5b8c\u6bd5\u3002\u5e38\u89c1\u7528\u9014\uff1a\u6570\u636e\u79c1\u6709\u5316\u3001\u56de\u8c03\u51fd\u6570\u3001\u51fd\u6570\u5de5\u5382\u3002\n\nQ: Promise \u548c async/await \u7684\u533a\u522b\nA: async/await \u662f Promise \u7684\u8bed\u6cd5\u7cd6\u3002\u524d\u8005\u5199\u6cd5\u50cf\u540c\u6b65\u4ee3\u7801\uff0c\u7528 try/catch \u6355\u83b7\u9519\u8bef\uff1b\u540e\u8005\u7528 .then()/.catch() \u94fe\u5f0f\u8c03\u7528\u3002async/await \u66f4\u6613\u8bfb\uff0c\u4f46 Promise.all() \u5728\u5904\u7406\u5e76\u53d1\u8bf7\u6c42\u65f6\u66f4\u65b9\u4fbf\u3002", "mimetype": "text/plain", "start_char_idx": 0, "end_char_idx": 625, "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}, "dcd13f80-550c-4add-8be2-4d3caab06462": {"__data__": {"id_": "dcd13f80-550c-4add-8be2-4d3caab06462", "embedding": null, "metadata": {"category": "\u524d\u7aef\u6846\u67b6", "source": "frontend\u6846\u67b6.txt"}, "excluded_embed_metadata_keys": [], "excluded_llm_metadata_keys": [], "relationships": {"1": {"node_id": "eb24cb3b-f126-4625-a79d-822875599477", "node_type": "4", "metadata": {"category": "\u524d\u7aef\u6846\u67b6", "source": "frontend\u6846\u67b6.txt"}, "hash": "3546f1088504328a77ba14537e32a03993e1418ea3e99f1d506832e4c1b3d85f", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "## \u524d\u7aef\u6846\u67b6\u9762\u8bd5\u9898\n\n### React\nQ: React \u7684\u865a\u62df DOM \u539f\u7406\nA: React \u5728\u5185\u5b58\u4e2d\u7ef4\u62a4\u4e00\u68f5\u865a\u62df DOM \u6811\uff08JS \u5bf9\u8c61\uff09\uff0c\u72b6\u6001\u53d8\u5316\u65f6\u751f\u6210\u65b0\u7684\u865a\u62df DOM\uff0c\u901a\u8fc7 Diff \u7b97\u6cd5\uff08\u540c\u5c42\u6bd4\u8f83 + key \u4f18\u5316\uff09\u627e\u51fa\u5dee\u5f02\uff0c\u6700\u540e\u6279\u91cf\u66f4\u65b0\u771f\u5b9e DOM\u3002\u8fd9\u907f\u514d\u4e86\u76f4\u63a5\u64cd\u4f5c DOM \u7684\u6027\u80fd\u5f00\u9500\u3002\n\nQ: useState \u548c useEffect \u7684\u7528\u6cd5\nA: useState \u7528\u4e8e\u5728\u51fd\u6570\u7ec4\u4ef6\u4e2d\u7ba1\u7406\u72b6\u6001\uff0c\u8fd4\u56de [state, setState]\u3002useEffect \u7528\u4e8e\u5904\u7406\u526f\u4f5c\u7528\uff08\u6570\u636e\u8bf7\u6c42\u3001DOM \u64cd\u4f5c\u3001\u8ba2\u9605\uff09\uff0c\u7b2c\u4e8c\u4e2a\u53c2\u6570\u662f\u4f9d\u8d56\u6570\u7ec4\uff0c\u7a7a\u6570\u7ec4\u8868\u793a\u53ea\u5728\u6302\u8f7d\u65f6\u6267\u884c\u4e00\u6b21\uff0c\u4e0d\u4f20\u5219\u6bcf\u6b21\u6e32\u67d3\u90fd\u6267\u884c\u3002\n\nQ: React.memo \u548c useMemo \u7684\u533a\u522b\nA: React.memo \u662f HOC\uff0c\u5305\u88f9\u7ec4\u4ef6\u540e\u5bf9 props \u505a\u6d45\u6bd4\u8f83\uff0c\u4e0d\u53d8\u5219\u8df3\u8fc7\u6e32\u67d3\u3002useMemo \u662f Hook\uff0c\u5728\u7ec4\u4ef6\u5185\u90e8\u7f13\u5b58\u8ba1\u7b97\u7ed3\u679c\u3002\u524d\u8005\u7f13\u5b58\u7ec4\u4ef6\uff0c\u540e\u8005\u7f13\u5b58\u503c\u3002\n\n### Vue\nQ: Vue \u7684\u54cd\u5e94\u5f0f\u539f\u7406\nA: Vue2 \u7528 Object.defineProperty \u52ab\u6301 getter/setter\uff1bVue3 \u7528 Proxy \u4ee3\u7406\u6574\u4e2a\u5bf9\u8c61\uff0c\u89e3\u51b3\u4e86 Vue2 \u65e0\u6cd5\u68c0\u6d4b\u65b0\u589e\u5c5e\u6027\u548c\u6570\u7ec4\u7d22\u5f15\u53d8\u5316\u7684\u95ee\u9898\u3002\u4f9d\u8d56\u6536\u96c6\u901a\u8fc7 Dep \u548c Watcher \u5b9e\u73b0\uff0c\u6570\u636e\u53d8\u5316\u65f6\u81ea\u52a8\u901a\u77e5\u7ec4\u4ef6\u66f4\u65b0\u3002\n\nQ: computed \u548c watch \u7684\u533a\u522b\nA: computed \u662f\u8ba1\u7b97\u5c5e\u6027\uff0c\u57fa\u4e8e\u4f9d\u8d56\u7f13\u5b58\uff0c\u53ea\u6709\u4f9d\u8d56\u53d8\u5316\u624d\u91cd\u65b0\u8ba1\u7b97\uff0c\u6709\u8fd4\u56de\u503c\u3002watch \u662f\u4fa6\u542c\u5668\uff0c\u76d1\u542c\u6570\u636e\u53d8\u5316\u540e\u6267\u884c\u5f02\u6b65\u64cd\u4f5c\u6216\u526f\u4f5c\u7528\uff0c\u9ed8\u8ba4\u4e0d\u7f13\u5b58\u3002computed \u9002\u5408\u5c55\u793a\u5c42\u903b\u8f91\uff0cwatch \u9002\u5408\u6570\u636e\u53d8\u5316\u540e\u7684\u64cd\u4f5c\u3002", "mimetype": "text/plain", "start_char_idx": 0, "end_char_idx": 712, "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}, "a8923641-bb60-43dd-9493-ae60264f1fca": {"__data__": {"id_": "a8923641-bb60-43dd-9493-ae60264f1fca", "embedding": null, "metadata": {"category": "\u7b97\u6cd5", "source": "\u7b97\u6cd5\u4e0e\u6570\u636e\u7ed3\u6784.txt"}, "excluded_embed_metadata_keys": [], "excluded_llm_metadata_keys": [], "relationships": {"1": {"node_id": "3915dc44-cb5c-499a-af03-ddffaf753323", "node_type": "4", "metadata": {"category": "\u7b97\u6cd5", "source": "\u7b97\u6cd5\u4e0e\u6570\u636e\u7ed3\u6784.txt"}, "hash": "7ca095ce868254de9c1b56a1d548ae24402af4c3ca4fae33a9705f38746dbd50", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "## \u7b97\u6cd5\u4e0e\u6570\u636e\u7ed3\u6784\u9762\u8bd5\u9898\n\n### \u57fa\u7840\u6570\u636e\u7ed3\u6784\nQ: \u6570\u7ec4\u548c\u94fe\u8868\u7684\u533a\u522b\nA: \u6570\u7ec4\u5185\u5b58\u8fde\u7eed\uff0cO(1) \u968f\u673a\u8bbf\u95ee\uff0c\u63d2\u5165\u5220\u9664 O(n)\u3002\u94fe\u8868\u5185\u5b58\u4e0d\u8fde\u7eed\uff0cO(n) \u968f\u673a\u8bbf\u95ee\uff0c\u63d2\u5165\u5220\u9664 O(1)\uff08\u5df2\u77e5\u4f4d\u7f6e\uff09\u3002\u6570\u7ec4\u9002\u5408\u8bfb\u591a\u5199\u5c11\uff0c\u94fe\u8868\u9002\u5408\u9891\u7e41\u589e\u5220\u3002\n\nQ: \u6808\u548c\u961f\u5217\u7684\u5e94\u7528\u573a\u666f\nA: \u6808\uff08LIFO\uff09\uff1a\u51fd\u6570\u8c03\u7528\u6808\u3001\u62ec\u53f7\u5339\u914d\u3001\u64a4\u9500\u64cd\u4f5c\u3001DFS\u3002\u961f\u5217\uff08FIFO\uff09\uff1a\u6d88\u606f\u961f\u5217\u3001BFS\u3001\u6253\u5370\u4efb\u52a1\u961f\u5217\u3001\u8bf7\u6c42\u6392\u961f\u3002\n\n### \u5e38\u89c1\u7b97\u6cd5\nQ: \u5feb\u6392\u7684\u539f\u7406\u548c\u590d\u6742\u5ea6\nA: \u5206\u6cbb\u601d\u60f3\uff1a\u9009\u57fa\u51c6\u503c pivot\uff0c\u5206\u533a\uff08\u5c0f\u7684\u653e\u5de6\u8fb9\uff0c\u5927\u7684\u653e\u53f3\u8fb9\uff09\uff0c\u9012\u5f52\u6392\u5e8f\u5de6\u53f3\u5b50\u6570\u7ec4\u3002\u5e73\u5747 O(nlogn)\uff0c\u6700\u574f O(n\u00b2)\uff08\u5df2\u6392\u5e8f + \u9009\u7b2c\u4e00\u4e2a\u4e3a pivot\uff09\u3002\u4f18\u5316\uff1a\u968f\u673a\u9009 pivot\u3001\u4e09\u6570\u53d6\u4e2d\u6cd5\u3002\n\nQ: \u52a8\u6001\u89c4\u5212\u548c\u8d2a\u5fc3\u7684\u533a\u522b\nA: \u52a8\u6001\u89c4\u5212\u9002\u7528\u4e8e\u6709\u91cd\u53e0\u5b50\u95ee\u9898\u548c\u6700\u4f18\u5b50\u7ed3\u6784\u7684\u95ee\u9898\uff0c\u901a\u8fc7\u72b6\u6001\u8f6c\u79fb\u65b9\u7a0b\u6c42\u89e3\uff0c\u4f1a\u8bb0\u5f55\u6240\u6709\u5b50\u95ee\u9898\u7b54\u6848\uff08\u5982\u80cc\u5305\u95ee\u9898\u3001\u6700\u957f\u516c\u5171\u5b50\u5e8f\u5217\uff09\u3002\u8d2a\u5fc3\u6bcf\u4e00\u6b65\u9009\u5c40\u90e8\u6700\u4f18\uff0c\u4e0d\u4fdd\u8bc1\u5168\u5c40\u6700\u4f18\uff0c\u9002\u7528\u573a\u666f\u66f4\u5c11\uff08\u5982\u627e\u96f6\u3001\u6700\u5c0f\u751f\u6210\u6811\uff09\u3002", "mimetype": "text/plain", "start_char_idx": 0, "end_char_idx": 440, "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}}, "docstore/metadata": {"cf2dca25-9b19-47be-9674-fa770704a7ec": {"doc_hash": "c17074a11ede053c2b9f7d695467fdaa6f64e73c3707990203d36609898b3e37", "ref_doc_id": "d43c2a0c-dcd3-4aac-8d18-1c20b67f1932"}, "e9333c1c-fff0-45d8-9dce-f99c394a442c": {"doc_hash": "3a582885aa6a9f6146915bc53181a3c8b5a91430b94f89a525811894e1065602", "ref_doc_id": "3badbb04-07dc-4857-a59e-5918a794cb88"}, "dcd13f80-550c-4add-8be2-4d3caab06462": {"doc_hash": "49f7123961ffef2519d6c547a3bafe2243e1e41ed56b43c7703cb653d538e1ea", "ref_doc_id": "eb24cb3b-f126-4625-a79d-822875599477"}, "a8923641-bb60-43dd-9493-ae60264f1fca": {"doc_hash": "c3d0d18737f1e2793fa9c7efaf6eedc13d0a5bf6412258a461d2a0dacc3d4979", "ref_doc_id": "3915dc44-cb5c-499a-af03-ddffaf753323"}}}