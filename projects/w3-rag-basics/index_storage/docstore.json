0\u8981\u989d\u5916\u63d0\u4f9b\u8eab\u4efd\u8bc1\u4fe1\u606f\u7528\u4e8e\u6e05\u5173\u3002\n\n## \u4f1a\u5458\u6743\u76ca\n\u666e\u901a\u4f1a\u5458\uff1a\u6d88\u8d39\u6bcf\u6ee1 100 \u5143\u79ef 1 \u5206\uff0c\u79ef\u5206\u53ef\u5151\u6362\u4f18\u60e0\u5238\u3002\n\u9ec4\u91d1\u4f1a\u5458\uff1a\u5e74\u6d88\u8d39\u6ee1 5000 \u5143\u5347\u7ea7\uff0c\u4eab\u5168\u573a 9.5 \u6298\uff0c\u751f\u65e5\u5f53\u6708\u53cc\u500d\u79ef\u5206\u3002\n\u94bb\u77f3\u4f1a\u5458\uff1a\u5e74\u6d88\u8d39\u6ee1 20000 \u5143\u5347\u7ea7\uff0c\u4eab\u5168\u573a 9 \u6298\uff0c\u4e13\u5c5e\u5ba2\u670d\u901a\u9053\uff0c\u4f18\u5148\u53d1\u8d27\u3002\n\n## \u5e38\u89c1\u95ee\u9898\nQ: \u6536\u5230\u7684\u5546\u54c1\u6709\u8d28\u91cf\u95ee\u9898\u600e\u4e48\u529e\uff1f\nA: \u8bf7\u5728\u7b7e\u6536\u540e 24 \u5c0f\u65f6\u5185\u62cd\u7167\u8054\u7cfb\u5ba2\u670d\uff0c\u6211\u4eec\u4f1a\u5b89\u6392\u6362\u8d27\u6216\u9000\u6b3e\uff0c\u90ae\u8d39\u7531\u6211\u4eec\u627f\u62c5\u3002\n\nQ: \u53ef\u4ee5\u4fee\u6539\u8ba2\u5355\u5730\u5740\u5417\uff1f\nA: \u672a\u53d1\u8d27\u7684\u8ba2\u5355\u53ef\u4ee5\u5728 APP \u8ba2\u5355\u8be6\u60c5\u9875\u81ea\u52a9\u4fee\u6539\u3002\u5df2\u53d1\u8d27\u7684\u8ba2\u5355\u9700\u8981\u8054\u7cfb\u5ba2\u670d\u62e6\u622a\u5feb\u9012\u3002\n\nQ: \u4f18\u60e0\u5238\u53ef\u4ee5\u53e0\u52a0\u4f7f\u7528\u5417\uff1f", "mimetype": "text/plain", "start_char_idx": 0, "end_char_idx": 497, "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}, "91b3ce30-bd96-43d0-9b3d-d02a5b3044ae": {"__data__": {"id_": "91b3ce30-bd96-43d0-9b3d-d02a5b3044ae", "embedding": null, "metadata": {}, "excluded_embed_metadata_keys": [], "excluded_llm_metadata_keys": [], "relationships": {"1": {"node_id": "5deff556-0658-4b5f-a400-25a25b16dbd5", "node_type": "4", "metadata": {}, "hash": "4b1d0c7c7611255803b546d9a80f092d9755ae8e1c6d957c1bcf8de220842e51", "class_name": "RelatedNodeInfo"}, "2": {"node_id": "880e9c33-7b0e-4177-8426-185e17dc4744", "node_type": "1", "metad